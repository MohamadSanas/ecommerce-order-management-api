# Application Settings
PROJECT_NAME="E-Commerce Order Management API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY="dev_secret_key_change_in_production_simhealth_prep"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database (Asyncpg driver for SQLAlchemy 2.0)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="ecommerce_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"
